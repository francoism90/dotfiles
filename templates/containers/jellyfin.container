[Unit]
Description=Jellyfin container

[Container]
Image=docker.io/jellyfin/jellyfin:latest
AutoUpdate=registry
LogDriver=none
Volume=jellyfin-config:/config:rw,Z,U
Volume=jellyfin-cache:/cache:rw,Z,U
Volume=/var/mnt/media:/media:rw,Z,U
UserNS=keep-id
GroupAdd=keep-groups
AddDevice=/dev/dri/:/dev/dri/
PublishPort=8096:8096
Notify=healthy
HealthStartupCmd=curl -fsS -o /dev/null http://127.0.0.1:8096/health
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:8096/health
HealthInterval=5m
HealthTimeout=15s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30
SuccessExitStatus=0 143

[Install]
WantedBy=default.target
