[Unit]
Description=Homarr container
Requires=podman.socket
After=podman.socket

[Container]
Image=ghcr.io/homarr-labs/homarr:latest
AutoUpdate=registry
Volume=homarr-appdata:/appdata:rw,Z,U
# Docker integration: lets Homarr list and control containers (remove both lines to opt out)
Volume=%t/podman/podman.sock:/var/run/docker.sock
SecurityLabelDisable=true
Secret=homarr-encryption-key,type=env,target=SECRET_ENCRYPTION_KEY
PublishPort=127.0.0.1:7575:7575
# Integrations: 169.254.1.3 is the host's loopback (e.g. http://169.254.1.3:8096 for Jellyfin)
Network=pasta:--map-host-loopback,169.254.1.3

[Service]
Restart=on-failure
SuccessExitStatus=143
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=default.target
