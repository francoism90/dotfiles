[Unit]
Description=Immich machine learning container

[Container]
Image=ghcr.io/immich-app/immich-machine-learning:release
AutoUpdate=registry
Pod=immich.pod
EnvironmentFile=%h/.config/containers/systemd/immich/immich.env
Volume=immich-model-cache:/cache:rw,Z,U

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
