{
    "autoContinueAtUsageLimit": false,
    "cleanupPeriodDays": 365,
    "enabledPlugins": {
        "telemetry@builtin": false
    },
    "permissions": {
        "allow": [
            "Bash(gh:*)",
            "Bash(flare:*)",
            "Bash(there-there:*)",
            "Bash(mailcoach:*)",
            "Bash(curl:*)",
            "Bash(composer:*)",
            "Bash(vendor/bin/phpunit:*)",
            "Bash(vendor/bin/pest:*)",
            "Bash(git:*)",
            "Bash(php artisan:*)",
            "Bash(npm:*)",
            "Bash(npx:*)",
            "Bash(yarn:*)",
            "Bash(pnpm:*)",
            "Bash(php:*)",
            "Bash(docker:*)",
            "Bash(docker-compose:*)",
            "Bash(make:*)",
            "Bash(brew:*)",
            "Bash(sed:*)",
            "Bash(cat:*)",
            "Bash(ls:*)",
            "Bash(grep:*)",
            "Bash(find:*)",
            "Bash(echo:*)",
            "Bash(mkdir:*)",
            "Bash(cp:*)",
            "Bash(mv:*)",
            "Bash(touch:*)",
            "Bash(chmod:*)",
            "Bash(pwd:*)",
            "Bash(which:*)",
            "Bash(whoami:*)",
            "Bash(date:*)",
            "Bash(wc:*)",
            "Bash(sort:*)",
            "Bash(uniq:*)",
            "Bash(head:*)",
            "Bash(tail:*)",
            "Bash(diff:*)",
            "Bash(awk:*)",
            "Bash(cut:*)",
            "Bash(tr:*)",
            "Bash(open:*)",
            "WebSearch",
            "WebFetch",
            "mcp__laravel-boost__*"
        ],
        "ask": [
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Read(~/.claude/.credentials.json)",
            "Read(~/.codex/config.toml)",
            "Read(**/.env)",
            "Read(**/.env.*)"
        ],
        "defaultMode": "auto"
    },
    "theme": "dark"
}