{
    "theme": "dark",
    "autoContinueAtUsageLimit": false,
    "enabledPlugins": {
        "telemetry@builtin": false
    },
    "attribution": {
        "commit": "",
        "pr": ""
    },
    "permissions": {
        "defaultMode": "auto",
        "ask": [
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Read(~/.claude/.credentials.json)",
            "Read(~/.codex/config.toml)",
            "Read(**/.env)",
            "Read(**/.env.*)",
            "Read(~/.config/gh/hosts.yml)",
            "Read(~/.config/containers/auth.json)",
            "Read(~/.gnupg/**)"
        ]
    }
}
